{
  "name": "premium-effects-registry",
  "version": "1.0.0",
  "description": "Catálogo local y consultable de referencias visuales GitHub verificadas (11 entradas iniciales; ampliación revisada).",
  "type": "commonjs",
  "author": "belentani7",
  "license": "MIT",
  "keywords": [
    "frontend",
    "effects",
    "liquid logo",
    "webgl",
    "three.js",
    "gsap",
    "shaders",
    "glsl",
    "particles",
    "cyberpunk",
    "creative-coding",
    "animation",
    "3d",
    "scroll",
    "cursor effects"
  ],
  "skills": {
    "id": "premium-effects-registry",
    "name": "Premium Effects Registry",
    "description": "Catalogo curado de los mejores repos GitHub para efectos visuales premium en frontend — 50+ repos organizados por categoria (liquid logos, 3D/WebGL, GLSL, GSAP, particles, cyberpunk, creative coding, scroll, cursor)",
    "triggers": [
      "efectos premium",
      "liquid logo",
      "3d webgl",
      "shader glsl",
      "particle effect",
      "gsap animation",
      "cyberpunk ui",
      "creative coding",
      "scroll animation",
      "cursor effect",
      "awwwards",
      "futuristic design"
    ]
  },
  "bin": {
    "effects": "./bin/effects.cjs"
  },
  "scripts": {
    "search": "node bin/effects.cjs",
    "categories": "node bin/effects.cjs --categories",
    "validate": "node -e \"require('./src/registry.cjs').loadCatalog(); console.log('Catalog validated')\"",
    "test": "node --test",
    "verify": "npm run validate && npm test",
    "build": "npm run verify"
  },
  "engines": {
    "node": ">=18"
  }
}
